# Variáveis do Servioeste Estoque (copie para .env com `make up`). Nada real aqui.

# ---------------------------------------------------------------- back-end
ENVIRONMENT=development
# DATABASE_URL vem do docker-compose; fora do Docker o padrão é o Postgres em localhost:5435.
ALLOWED_ORIGINS=http://localhost:5177
# Pessoa usada em desenvolvimento quando a requisição não vem do Hub (ignorada em produção).
# DEV_USUARIO_EMAIL=ana.souza@exemplo.com.br
# DEV_USUARIO_NOME=Ana Paula Souza
# DEV_USUARIO_PAPEL_HUB=admin

# Postgres do Docker de desenvolvimento
POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque
POSTGRES_DB=estoque

# ---------------------------------------------------------------- front-end
# (system-servioeste-estoque-front/.env.development.local)
# VITE_MOCK=true                      # liga os dados simulados (ou use `make front-mock`)
# VITE_HUB_URL=http://localhost:5174  # link "Voltar ao Hub"
